# ─── Database ────────────────────────────────────────────────────────────────
# Local development uses SQLite via Prisma. For staging/production use PostgreSQL:
#   DATABASE_URL="postgresql://user:password@host:5432/career_catalyst?schema=public&connection_limit=10"
DATABASE_URL="file:./dev.db"

# ─── Auth / sessions ─────────────────────────────────────────────────────────
# 64+ random chars. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Optional: email (password reset / verification delivery) ────────────────
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="Career Catalyst <no-reply@careercatalyst.dev>"

# ─── Optional: S3-compatible object storage (file uploads) ───────────────────
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ─── Optional: isolated code-execution runner (coding practice/questions) ────
# DEV DEFAULT: unset — a conservative heuristic evaluator scores submissions
#   WITHOUT executing student code on the app server (safe by construction).
# PRODUCTION: point at a sandboxed runner (Judge0 / Firecracker / gVisor pool).
# CODE_RUNNER_URL="https://runner.internal/"
# CODE_RUNNER_TOKEN=""
